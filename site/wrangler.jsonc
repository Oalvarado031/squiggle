{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "squiggle",
  "account_id": "3c6da0286b93a75175cbc3f1f12c345a",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [
    { "pattern": "squigglee.online", "custom_domain": true },
    { "pattern": "www.squigglee.online", "custom_domain": true }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  // Pin renders (a still + a 45-frame preview) and OG cards run resvg; give them room.
  "limits": { "cpu_ms": 30000 },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "squiggle", "database_id": "1e919185-669e-44a2-a54d-a2f54c28ffd4", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "squiggle-media" }],
  "kv_namespaces": [{ "binding": "KV", "id": "da4e883825d04809a46386d02ea911e8" }],
  "vars": {
    // Set TOKEN_MINT to show the contract address in the footer chip.
    "TOKEN_MINT": "",
    // The values below come from squiggle.config.json (npm run sync-config). Empty hides the link.
    "REPO_URL": "",
    "X_URL": "",
    "AUTHOR_NAME": "",
    "AUTHOR_URL": "",
    // the workers.dev address redirects here (the API stays reachable on both)
    "CANONICAL_HOST": "squigglee.online"
  },
  // Monday 00:05 UTC: close last week's prompt and stamp its top three.
  "triggers": { "crons": ["5 0 * * 1"] }
}
