{
  "information_for_contributors": [
    "Generated by packages/vscode/scripts/gen-grammar.mjs from packages/core/src/vocab.ts.",
    "Do not edit by hand: change the vocabulary or the script, then run `npm run gen -w squiggle-vscode`."
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Squiggle",
  "scopeName": "source.squiggle",
  "fileTypes": ["sqg"],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#make"
    },
    {
      "include": "#block-header"
    },
    {
      "include": "#command"
    },
    {
      "include": "#user-command"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.squiggle",
      "begin": "//",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.squiggle"
        }
      },
      "end": "$"
    },
    "make": {
      "name": "meta.function.squiggle",
      "begin": "^\\s*(make)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.make.squiggle"
        },
        "2": {
          "name": "entity.name.function.squiggle"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.parameter.squiggle"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameters.squiggle"
        }
      ]
    },
    "block-header": {
      "patterns": [
        {
          "match": "^\\s*(every)[ \\t]+(frame)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.every.squiggle"
            },
            "2": {
              "name": "keyword.control.every.squiggle"
            }
          }
        },
        {
          "match": "^\\s*(when)[ \\t]+(key)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.when.squiggle"
            },
            "2": {
              "name": "keyword.control.when.squiggle"
            }
          }
        },
        {
          "match": "^\\s*(when)[ \\t]+(click)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.when.squiggle"
            },
            "2": {
              "name": "keyword.control.when.squiggle"
            }
          }
        }
      ]
    },
    "command": {
      "match": "^\\s*\\b(color|paper|shape|width|write|grow|line|move|path|ring|seed|spin|box|dot|say)\\b(?=[ \\t(]|$)",
      "captures": {
        "1": {
          "name": "support.function.command.squiggle"
        }
      }
    },
    "user-command": {
      "match": "^\\s*(?!(?:repeat|chalk|clamp|click|color|ember|every|false|floor|frame|lilac|mouse|night|noise|ochre|paper|polar|range|round|shape|width|write|atan|bone|ceil|clay|coal|dist|ease|else|fade|grow|keep|leaf|lerp|line|make|moss|move|path|pick|plum|rand|ring|rose|rust|sand|seed|sign|spin|sqrt|true|turn|when|abs|and|ash|box|cos|dot|for|hue|ink|key|len|max|min|mix|not|rgb|say|sea|sin|sky|tan|as|if|in|or|pi|t)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]+(?:[0-9\"#]|\\.[0-9]|\\[|\\(|-(?![=\\s])|(?!(?:and|or|as|in)\\b)[A-Za-z_]))",
      "captures": {
        "1": {
          "name": "entity.name.function.squiggle"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#color"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#builtin"
        },
        {
          "include": "#call"
        },
        {
          "include": "#property"
        },
        {
          "include": "#name"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#illegal"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.squiggle",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.squiggle"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.squiggle"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.squiggle"
        }
      ]
    },
    "color": {
      "patterns": [
        {
          "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})(?![A-Za-z0-9_])",
          "name": "constant.other.color.rgb-value.hex.squiggle"
        },
        {
          "match": "#[A-Za-z0-9_]*",
          "name": "invalid.illegal.color.squiggle"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?:\\d+(?:\\.\\d+)?|\\.\\d+)[A-Za-z_][A-Za-z0-9_]*",
          "name": "invalid.illegal.number.squiggle"
        },
        {
          "match": "(?:\\d+(?:\\.\\d+)?|\\.\\d+)",
          "name": "constant.numeric.decimal.squiggle"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(?:and|not|or)\\b",
          "name": "keyword.operator.word.squiggle"
        },
        {
          "match": "\\b(?:false|true)\\b",
          "name": "constant.language.boolean.squiggle"
        },
        {
          "match": "\\b(?:repeat|click|every|frame|else|keep|make|when|for|key|as|if|in)\\b",
          "name": "keyword.control.squiggle"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "match": "\\b(?:clamp|floor|noise|polar|range|round|atan|ceil|dist|ease|fade|lerp|pick|rand|sign|sqrt|abs|cos|hue|len|max|min|mix|rgb|sin|tan)\\b",
          "name": "support.function.builtin.squiggle"
        },
        {
          "match": "\\b(?:mouse|turn|pi|t)\\b",
          "name": "constant.language.squiggle"
        },
        {
          "match": "\\b(?:chalk|ember|lilac|night|ochre|paper|bone|clay|coal|leaf|moss|plum|rose|rust|sand|ash|ink|sea|sky)\\b",
          "name": "support.constant.color.squiggle"
        }
      ]
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.squiggle"
        }
      }
    },
    "property": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.squiggle"
        },
        "2": {
          "name": "variable.other.property.squiggle"
        }
      }
    },
    "name": {
      "match": "[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.squiggle"
    },
    "operator": {
      "patterns": [
        {
          "match": "[+\\-*/]=",
          "name": "keyword.operator.assignment.compound.squiggle"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.squiggle"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.squiggle"
        },
        {
          "match": "[+\\-*/%^]",
          "name": "keyword.operator.arithmetic.squiggle"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.squiggle"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.squiggle"
        },
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.squiggle"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.squiggle"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.squiggle"
        }
      ]
    },
    "illegal": {
      "match": "[':;{}&|!]",
      "name": "invalid.illegal.character.squiggle"
    }
  }
}
