{
  "name": "squiggle-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode",
    "site"
  ],
  "scripts": {
    "gen": "node scripts/gen-examples.mjs",
    "test": "npm run gen && vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p site && tsc --noEmit -p site/src/worker",
    "build:cli": "npm run build -w squigglelang && node scripts/build-action.mjs",
    "build:site": "npm run build -w squiggle-site",
    "deploy": "npm run deploy -w squiggle-site",
    "e2e": "playwright test",
    "vsix": "npm run package -w squiggle-vscode",
    "record": "npm run gen && esbuild scripts/record.ts --bundle --platform=node --format=esm --outfile=out/record.mjs --external:@napi-rs/canvas --external:@resvg/resvg-wasm --log-level=warning && node out/record.mjs",
    "hero-gif": "esbuild scripts/hero-gif.ts --bundle --platform=node --format=esm --outfile=out/hero-gif.mjs --external:@napi-rs/canvas --log-level=warning && node out/hero-gif.mjs",
    "sync-config": "node scripts/sync-config.mjs"
  },
  "devDependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
