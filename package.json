{
  "name": "squiggle-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode",
    "site"
  ],
  "scripts": {
    "gen": "node scripts/gen-examples.mjs",
    "test": "npm run gen && vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p site",
    "build:cli": "npm run build -w squigglelang",
    "build:site": "npm run build -w squiggle-site",
    "deploy": "npm run deploy -w squiggle-site"
  },
  "devDependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
